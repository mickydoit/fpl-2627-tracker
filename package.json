{
  "name": "fpl-2627-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Fantasy Premier League 2026/27 tracker, squad optimiser and transfer suggester. Static site + GitHub Actions data pipeline.",
  "type": "module",
  "scripts": {
    "fetch": "node scripts/fetch-all.mjs",
    "derive": "node scripts/derive.mjs",
    "evaluate": "node scripts/evaluate.mjs",
    "refresh": "node scripts/fetch-all.mjs && node scripts/archive-gameweek.mjs && node scripts/derive.mjs",
    "archive": "node scripts/archive-gameweek.mjs",
    "seed": "node scripts/make-sample.mjs",
    "seed:draft": "node scripts/make-draft-sample.mjs",
    "refresh:draft": "node scripts/fetch-draft.mjs",
    "experimental:draft-live": "node scripts/draft-live.mjs",
    "freeze-prior": "node scripts/freeze-prior.mjs",
    "test:draft": "node scripts/test-draft.mjs",
    "test": "node scripts/make-sample.mjs && node scripts/make-draft-sample.mjs && node scripts/test.mjs && node scripts/test-draft.mjs && node scripts/test-warehouse.mjs",
    "serve": "python3 -m http.server 8080",
    "diagnostics": "node scripts/draft-diagnostics.mjs",
    "warehouse:structural": "node scripts/warehouse/fetch-football-data.mjs",
    "warehouse:performance": "node scripts/warehouse/fetch-espn-matches.mjs",
    "warehouse:identity": "node scripts/warehouse/build-identity.mjs",
    "warehouse:normalise": "node scripts/warehouse/normalise.mjs",
    "warehouse:coverage": "node scripts/warehouse/coverage.mjs",
    "test:warehouse": "node scripts/test-warehouse.mjs",
    "warehouse:playerseasons": "node scripts/warehouse/fetch-player-seasons.mjs",
    "warehouse:xref": "node scripts/warehouse/build-xref.mjs",
    "research:promoted": "node scripts/warehouse/research/promoted-clubs.mjs",
    "research:continuity": "node scripts/warehouse/research/squad-continuity.mjs",
    "research:transfers": "node scripts/warehouse/research/transfers.mjs",
    "research:teamstrength": "node scripts/warehouse/research/team-strength.mjs",
    "research:h2h": "node scripts/warehouse/research/head-to-head.mjs",
    "prospective": "node scripts/warehouse/research/prospective-report.mjs",
    "freeze:manifest": "node scripts/warehouse/research/freeze-manifest.mjs",
    "prospective:collect": "node scripts/warehouse/fetch-prospective-outcomes.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
